// ============================================================
// LA GRANDE ROUTE — src/core/music.js
// 3 pistes : general (=map) / combat / boss.
// general tourne en continu (titre, map, village, victoire,
// defaite) SANS redemarrer a chaque changement de scene.
// ============================================================
window.MUS = window.MUS || { on:true, vol:.5, fileVol:.3, wanted:'map' };
try{ MUS.on = localStorage.getItem('lgr_mus')!=='0'; }catch(e){}
if(MUS.fileVol==null) MUS.fileVol=.3;

window.GameData = window.GameData || {};
window.GameData.music = window.GameData.music || {};
if(!window.GameData.music.base || !Object.keys(window.GameData.music.base).length){
window.GameData.music.base = { map:{mood:'map'}, combat:{mood:'combat'}, boss:{mood:'boss'} };
}

var MCTX=null, master=null;
var curChannel=null;
var procTimer=null, procStep=0, procNext=0, procDeg=0, procMood='map';
var fileSrc=null, fileGain=null;
var unlocked=false;

var MOODS={
map:{bpm:84,root:55,scale:[0,2,3,5,7,8,10],pad:0,bell:1,drone:1,perc:0,bass:1},
combat:{bpm:138,root:52,scale:[0,1,3,5,7,8,10],pad:0,bell:0,drone:0,perc:1,bass:1,arp:1},
boss:{bpm:112,root:50,scale:[0,1,3,5,6,8,10],pad:1,bell:0,drone:1,perc:1,bass:1}
};

function mctx(){
if(!MCTX){
MCTX=new (window.AudioContext||window.webkitAudioContext)();
master=MCTX.createGain();
master.gain.value=MUS.vol*.6;
master.connect(MCTX.destination);
}
return MCTX;
}
function freq(m){return 440*Math.pow(2,(m-69)/12);}
function tone(t,m,dur,type,vol){
var c=mctx(),o=c.createOscillator(),g=c.createGain();
o.type=type;o.frequency.setValueAtTime(freq(m),t);
g.gain.setValueAtTime(0,t);
g.gain.linearRampToValueAtTime(vol,t+.02);
g.gain.exponentialRampToValueAtTime(.0001,t+dur);
o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.05);
}
function thump(t,vol){
var c=mctx(),o=c.createOscillator(),g=c.createGain();
o.type='sine';o.frequency.setValueAtTime(120,t);
o.frequency.exponentialRampToValueAtTime(40,t+.12);
g.gain.setValueAtTime(vol,t);
g.gain.exponentialRampToValueAtTime(.0001,t+.15);
o.connect(g);g.connect(master);o.start(t);o.stop(t+.2);
}
function tickNoise(t,vol){
var c=mctx(),n=Math.floor(c.sampleRate*.06);
var b=c.createBuffer(1,n,c.sampleRate),d=b.getChannelData(0);
for(var i=0;i<n;i++)d[i]=(Math.random()*2-1)*(1-i/n);
var s=c.createBufferSource(),g=c.createGain(),f=c.createBiquadFilter();
f.type='highpass';f.frequency.value=6000;
s.buffer=b;g.gain.value=vol;
s.connect(f);f.connect(g);g.connect(master);s.start(t);
}
function schedule(s,t,M,spb){
var L=M.scale.length;
if(M.drone&&s===0)tone(t,M.root-12,spb*32,'sine',.12);
if(M.pad&&s%32===0)[0,2,4].forEach(function(iv){tone(t,M.root+M.scale[iv%L],spb*30,'triangle',.05);});
if(M.bass&&s%8===0)tone(t,M.root-12+(s%16===8?M.scale[4]:0),spb*6,'triangle',.16);
if(M.arp&&s%2===0)tone(t,M.root+12+M.scale[(s*3)%L],spb*1.8,'square',.045);
if(M.bell&&s%2===0&&Math.random()<.38){
procDeg=Math.max(0,Math.min(L*2-1,procDeg+(Math.floor(Math.random()*5)-2)));
tone(t,M.root+12+M.scale[procDeg%L]+(procDeg>=L?12:0),spb*6,'sine',.09);
}
if(M.perc){
if(s%16===0)thump(t,.22);
if(s%8===4)tickNoise(t,.06);
if(s%4===2)tickNoise(t,.03);
}
}
function startProc(mood){
var c=mctx();
procMood=mood;procStep=0;procDeg=0;
procNext=c.currentTime+.1;
procTimer=setInterval(function(){
var M=MOODS[procMood]||MOODS.map;
var spb=60/M.bpm/4;
while(procNext<c.currentTime+.6){
schedule(procStep,procNext,M,spb);
procStep=(procStep+1)%64;
procNext+=spb;
}
},200);
}
function stopCurrent(){
if(procTimer){clearInterval(procTimer);procTimer=null;}
if(fileSrc){try{fileSrc.stop();}catch(e){}fileSrc=null;fileGain=null;}
}
function channelFor(key){
if(key==='combat')return 'combat';
if(key==='boss')return 'boss';
return 'general';
}
function trackFor(ch){
var sk=(ch==='general')?'map':ch;
var g=(window.GameData||{}).music||{};
var act=(typeof currentActId==='function')?currentActId():'act1';
var pk=(typeof S!=='undefined'&&S&&S.chemin)?(act+'_'+S.chemin):null;
if(pk&&g[pk]&&g[pk][sk])return g[pk][sk];
return (g[act]&&g[act][sk])||(g.base&&g.base[sk])||{mood:sk};
}
function playFile(tr,ch){
fetch(tr.file).then(function(r){if(!r.ok)throw 0;return r.arrayBuffer();})
.then(function(buf){return mctx().decodeAudioData(buf);})
.then(function(ab){
if(!MUS.on||curChannel!==ch)return;
var c=mctx(),src=c.createBufferSource(),g=c.createGain();
src.buffer=ab;src.loop=true;g.gain.value=(MUS.fileVol!=null)?MUS.fileVol:.3;
src.connect(g);g.connect(master);src.start();
fileSrc=src;fileGain=g;
}).catch(function(){
if(curChannel===ch)startProc(tr.mood||((ch==='general')?'map':ch));
});
}
function startChannel(ch){
stopCurrent();
curChannel=ch;
var tr=trackFor(ch);
if(tr.file){playFile(tr,ch);}
else{startProc(tr.mood||((ch==='general')?'map':ch));}
}
window.mus=function(key){
MUS.wanted=key;
if(!MUS.on||!unlocked)return;
var ch=channelFor(key);
if(ch===curChannel)return;   // <-- continuité : pas de redémarrage
startChannel(ch);
};
window.musToggle=function(){
MUS.on=!MUS.on;
try{localStorage.setItem('lgr_mus',MUS.on?'1':'0');}catch(e){}
if(MUS.on){unlocked=true;var c=mctx();if(c.state==='suspended')c.resume();curChannel=null;startChannel(channelFor(MUS.wanted));}
else{stopCurrent();curChannel=null;}
if(typeof sfx==='function')sfx('clic');
if(typeof rHud==='function')rHud();
};
window.musSetFileVol=function(v){MUS.fileVol=v;if(fileGain)fileGain.gain.value=v;};
function unlock(){
unlocked=true;
var c=mctx();
if(c.state==='suspended')c.resume();
if(MUS.on&&!curChannel)startChannel(channelFor(MUS.wanted));
document.removeEventListener('pointerdown',unlock);
document.removeEventListener('keydown',unlock);
}
document.addEventListener('pointerdown',unlock);
document.addEventListener('keydown',unlock);
